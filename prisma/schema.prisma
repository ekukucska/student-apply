generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgramType {
  BACHELOR
  MASTER
  CERTIFICATE
}

enum AppStatusEnum {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  applications ApplicationStatus[]
}

model Program {
  id          String      @id @default(cuid())
  name        String
  type        ProgramType
  studyField  String      @default("")
  university  String
  description String
  createdAt   DateTime    @default(now())

  applications ApplicationStatus[]
}

model ApplicationStatus {
  id        String        @id @default(cuid())
  userId    String
  programId String
  status    AppStatusEnum @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@unique([userId, programId])
}
